# Twilio Serverless deployment settings.
# Authentication is handled by the Twilio CLI profile from `twilio login`.
TWILIO_SERVERLESS_SERVICE_NAME=livekit-flex-handoff

# Optional. Set this if the phone number/Flex account is not your active Twilio CLI profile.
# Example: TWILIO_PROFILE=RBDEMO24
TWILIO_PROFILE=

# Flex / TaskRouter.
FLEX_WORKFLOW_SID=WWxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FLEX_WAIT_URL=

# Pattern A only. Studio Flow webhook URL used when returning the active call to Studio.
STUDIO_FLOW_WEBHOOK_URL=https://webhooks.twilio.com/v1/Accounts/ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx/Flows/FWxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# LiveKit SIP. do not include sip:
LIVEKIT_SIP_HOST=your-project.sip.livekit.cloud

# Twilio number used to send calls to LiveKit. This number must be in E.164 format, e.g. +15551234567
LIVEKIT_PHONE_NUMBER=+15551234567

# Arbitrary SIP digest auth credentials that you choose and configure in both places
LIVEKIT_SIP_USERNAME=livekit-sip-user
LIVEKIT_SIP_PASSWORD=replace_with_a_long_random_password

# Shared secret sent by the LiveKit agent tool to /escalate. 
# This should be a long random string that is hard to guess. It is used to verify that the request to /escalate is coming from the LiveKit agent tool and not from an attacker.
# You can generate one using a command like `openssl rand -base64 32` or `pwgen -s 32 1`. Put the same value in two places.
HANDOFF_TOKEN=replace_with_a_long_random_token

# Optional Twilio Conversation Memory.
# If set, use /voice_memory or /studio_voice_memory instead of /voice or /studio_voice.
MEMORY_STORE_ID=

# Optional for deployed Twilio Functions, where ACCOUNT_SID and AUTH_TOKEN are usually already available.
# Set these for local tests or if your Functions runtime does not expose the default credentials.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
